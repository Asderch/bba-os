# BBA OS ortam değişkenleri — bu dosyayı .env olarak kopyala ve doldur.
# .env dosyası .gitignore'da; PythonAnywhere'de bunları WSGI dosyasında
# os.environ[...] ile ayarla.

# --- Kimlik doğrulama (herkese açık bir sunucuda ZORUNLU) ---
# İkisi de boşsa auth kapalıdır (yalnızca yerel/masaüstü kullanım için).
BBA_USER=
BBA_PASS=

# --- Oturum imzalama anahtarı ---
# Boşsa her başlatmada rastgele üretilir (flash mesajları restart'ta kaybolur).
BBA_SECRET_KEY=

# --- Veritabanı ---
# Tanımlıysa MySQL, tanımlı değilse yerel SQLite (data/personal_os.db).
BBA_MYSQL_URI=

# --- Geliştirme ---
# 1 ise `python app.py` Werkzeug debugger'ı açar. Sunucuda ayarlama.
BBA_DEBUG=
